# Canonical production origin. Used by metadata, hreflang, sitemap and JSON-LD.
# Use the final public host without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://madmobteam.com

# Search Console verification tokens (optional; omit in local development).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (optional). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
